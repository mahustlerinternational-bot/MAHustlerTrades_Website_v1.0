# ============================================================
# MAHustler Trades — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe ───────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ── Transactional Email (Zoho SMTP) ──────────────────────────
# These application variables are required for non-auth emails such as the
# Elite Access approval notification. Configure them separately in Vercel even
# if the same Zoho account is already configured in Supabase Auth SMTP.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-confirmed-zoho-address@zohomail.com
SMTP_PASSWORD=your-zoho-app-password
SMTP_FROM_EMAIL=your-confirmed-zoho-address@zohomail.com
SMTP_FROM_NAME=MAHustler Trades
SMTP_REPLY_TO=

# Ziina Payment Gateway (https://ziina.com)
ZIINA_API_TOKEN=your_ziina_api_token_here
ZIINA_WEBHOOK_SECRET=your_random_webhook_hmac_secret_here

# Optional dedicated key for encrypting Telegram/Discord/EA secrets stored by
# the admin Signal Hub. If omitted, the service-role key is used as key material.
INTEGRATION_ENCRYPTION_KEY=generate_a_long_random_secret_here

# Optional AI member-support assistant. Without this key the secure built-in
# support assistant remains available. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
